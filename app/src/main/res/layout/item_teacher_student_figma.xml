<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    app:cardBackgroundColor="@color/white"
    app:cardCornerRadius="14dp"
    app:cardElevation="0.5dp"
    app:strokeColor="@color/hadirku_gray_border"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="14dp"
        android:paddingVertical="12dp">

        <!-- Caramel Avatar Circle -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="40dp"
            android:layout_height="40dp"
            app:cardBackgroundColor="@color/hadirku_caramel"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp"
            app:strokeWidth="0dp">

            <TextView
                android:id="@+id/tvStudentAvatarInitials"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="RA"
                android:textColor="@color/white"
                android:textSize="14sp"
                android:textStyle="bold" />
        </com.google.android.material.card.MaterialCardView>

        <!-- Name & NIS/Class -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvStudentItemName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Rina Aulia Putri"
                android:textColor="@color/hadirku_text_dark"
                android:textSize="13.5sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvStudentItemDetails"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="NIS 2410031 · XI IPA 2"
                android:textColor="@color/hadirku_text_muted"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Stats / Percentage -->
        <TextView
            android:id="@+id/tvStudentAttendancePercent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:text="95%"
            android:textColor="@color/hadirku_text_dark"
            android:textSize="13sp"
            android:textStyle="bold" />

        <!-- Status Pill Badge -->
        <TextView
            android:id="@+id/tvStudentStatusPill"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="#ECFDF5"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"
            android:text="Hadir"
            android:textColor="#059669"
            android:textSize="11sp"
            android:textStyle="bold" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
