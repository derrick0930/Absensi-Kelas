<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/scrollVerificationContent"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_dialog_sheet"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingTop="20dp"
        android:paddingBottom="36dp">

        <!-- Drag Handle -->
        <View
            android:layout_width="44dp"
            android:layout_height="4.5dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="16dp"
            android:background="#D1D5DB" />

        <!-- Subject & Teacher Subtitle (Figma Android Compact - 5) -->
        <TextView
            android:id="@+id/tvVerificationSubject"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Matematika · Pak Dedi Kurniawan"
            android:textColor="@color/hadirku_text_muted"
            android:textSize="13sp" />

        <!-- Title -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Verifikasi 3 lapis"
            android:textColor="@color/hadirku_text_dark"
            android:textSize="22sp"
            android:textStyle="bold" />

        <!-- Hidden class badge to preserve binding -->
        <TextView
            android:id="@+id/tvVerificationClassBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone" />

        <!-- Notice -->
        <TextView
            android:id="@+id/tvVerificationNotice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@color/hadirku_soft_mint"
            android:paddingHorizontal="12dp"
            android:paddingVertical="8dp"
            android:text="Presensi siswa wajib diverifikasi melalui 3 lapis: Lokasi Kelas, Sidik Jari, dan Wajah."
            android:textColor="@color/hadirku_primary"
            android:textSize="11.5sp" />

        <!-- ======================================================== -->
        <!-- STEP 1: LOKASI KELAS (KOORDINAT KELAS & RADIUS)          -->
        <!-- ======================================================== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="28dp"
                android:layout_height="28dp"
                app:cardBackgroundColor="@color/hadirku_primary"
                app:cardCornerRadius="14dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">

                <TextView
                    android:id="@+id/badgeStepLocation"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="1"
                    android:textColor="@color/white"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </com.google.android.material.card.MaterialCardView>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Lokasi kelas"
                    android:textColor="@color/hadirku_text_dark"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvLocationClassRule"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Pastikan kamu berada didalam kelas (radius maks 50 m)"
                    android:textColor="@color/hadirku_text_muted"
                    android:textSize="11.5sp" />

                <!-- Location Status Card -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    app:cardBackgroundColor="#FAFAFA"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/hadirku_gray_border"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <TextView
                                android:id="@+id/tvLocationStatusBadge"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="Memeriksa GPS..."
                                android:textColor="@color/hadirku_primary"
                                android:textSize="12.5sp"
                                android:textStyle="bold" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnRefreshLocation"
                                style="@style/Widget.Material3.Button.TonalButton"
                                android:layout_width="wrap_content"
                                android:layout_height="32dp"
                                android:backgroundTint="@color/hadirku_soft_mint"
                                android:paddingHorizontal="10dp"
                                android:text="Cek GPS"
                                android:textColor="@color/hadirku_primary"
                                android:textSize="11sp"
                                android:textStyle="bold"
                                app:cornerRadius="8dp"
                                app:strokeWidth="0dp" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/tvLocationDetails"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="Mencari koordinat kelas..."
                            android:textColor="@color/hadirku_text_muted"
                            android:textSize="11.5sp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnSimulateLocation"
                            style="@style/Widget.Material3.Button.TextButton"
                            android:layout_width="wrap_content"
                            android:layout_height="32dp"
                            android:layout_marginTop="2dp"
                            android:paddingHorizontal="4dp"
                            android:text="⚡ Simulasi Di Dalam Kelas (Demo)"
                            android:textColor="@color/hadirku_primary"
                            android:textSize="11sp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>
        </LinearLayout>

        <!-- ======================================================== -->
        <!-- STEP 2: SIDIK JARI                                       -->
        <!-- ======================================================== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="horizontal">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="28dp"
                android:layout_height="28dp"
                app:cardBackgroundColor="@color/hadirku_primary"
                app:cardCornerRadius="14dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">

                <TextView
                    android:id="@+id/badgeStepBiometric"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="2"
                    android:textColor="@color/white"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </com.google.android.material.card.MaterialCardView>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Sidik jari"
                    android:textColor="@color/hadirku_text_dark"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Tekan sensor sidik jari untuk verifikasi identitas."
                    android:textColor="@color/hadirku_text_muted"
                    android:textSize="11.5sp" />

                <!-- Fingerprint Action Card -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    app:cardBackgroundColor="#FAFAFA"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/hadirku_gray_border"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <TextView
                            android:id="@+id/tvBiometricStatusBadge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Belum terverifikasi"
                            android:textColor="@color/hadirku_text_muted"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvBiometricDetails"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="2dp"
                            android:text="Pindai sidik jari melalui sensor biometrik perangkat."
                            android:textColor="@color/hadirku_text_muted"
                            android:textSize="11.5sp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnTriggerBiometric"
                            style="@style/Widget.Material3.Button.TonalButton"
                            android:layout_width="match_parent"
                            android:layout_height="40dp"
                            android:layout_marginTop="8dp"
                            android:backgroundTint="@color/hadirku_soft_mint"
                            android:text="Pindai Sidik Jari"
                            android:textAllCaps="false"
                            android:textColor="@color/hadirku_primary"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            app:cornerRadius="10dp"
                            app:strokeWidth="0dp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>
        </LinearLayout>

        <!-- ======================================================== -->
        <!-- STEP 3: PENGENALAN WAJAH                                 -->
        <!-- ======================================================== -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:orientation="horizontal">

            <com.google.android.material.card.MaterialCardView
                android:layout_width="28dp"
                android:layout_height="28dp"
                app:cardBackgroundColor="@color/hadirku_primary"
                app:cardCornerRadius="14dp"
                app:cardElevation="0dp"
                app:strokeWidth="0dp">

                <TextView
                    android:id="@+id/badgeStepFace"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="3"
                    android:textColor="@color/white"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </com.google.android.material.card.MaterialCardView>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Pengenalan wajah"
                    android:textColor="@color/hadirku_text_dark"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="Arahkan wajah ke bingkai kamera depan."
                    android:textColor="@color/hadirku_text_muted"
                    android:textSize="11.5sp" />

                <!-- Face Scan Action Card -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    app:cardBackgroundColor="#FAFAFA"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="0dp"
                    app:strokeColor="@color/hadirku_gray_border"
                    app:strokeWidth="1dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="12dp">

                        <TextView
                            android:id="@+id/tvFaceStatusBadge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Belum terverifikasi"
                            android:textColor="@color/hadirku_text_muted"
                            android:textSize="12sp"
                            android:textStyle="bold" />

                        <!-- Face Camera Preview Frame -->
                        <FrameLayout
                            android:id="@+id/frameFaceCameraPreview"
                            android:layout_width="140dp"
                            android:layout_height="140dp"
                            android:layout_gravity="center_horizontal"
                            android:layout_marginTop="10dp"
                            android:background="@drawable/bg_scanner_reticle"
                            android:padding="4dp"
                            android:visibility="gone">

                            <androidx.camera.view.PreviewView
                                android:id="@+id/previewViewFace"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent" />

                            <View
                                android:id="@+id/overlayFaceGuide"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:background="@drawable/bg_scan_button_outer" />
                        </FrameLayout>

                        <!-- Progress indicator -->
                        <LinearLayout
                            android:id="@+id/layoutFaceScanningProgress"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:visibility="gone">

                            <ProgressBar
                                android:id="@+id/progressFaceAnalysis"
                                style="?android:attr/progressBarStyleSmall"
                                android:layout_width="22dp"
                                android:layout_height="22dp"
                                android:indeterminateTint="@color/hadirku_primary" />

                            <TextView
                                android:id="@+id/tvFaceScanningNotice"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="4dp"
                                android:text="Wajah terdeteksi. Menganalisis..."
                                android:textColor="@color/hadirku_primary"
                                android:textSize="11sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/tvFaceDetails"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:text="Kamera depan terbuka otomatis untuk memverifikasi wajah."
                            android:textColor="@color/hadirku_text_muted"
                            android:textSize="11.5sp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnTriggerFaceScan"
                            style="@style/Widget.Material3.Button.TonalButton"
                            android:layout_width="match_parent"
                            android:layout_height="40dp"
                            android:layout_marginTop="8dp"
                            android:backgroundTint="@color/hadirku_soft_mint"
                            android:text="Buka Kamera Wajah"
                            android:textAllCaps="false"
                            android:textColor="@color/hadirku_primary"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            app:cornerRadius="10dp"
                            app:strokeWidth="0dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnCancelFaceCamera"
                            style="@style/Widget.Material3.Button.TextButton"
                            android:layout_width="wrap_content"
                            android:layout_height="32dp"
                            android:layout_gravity="center_horizontal"
                            android:layout_marginTop="2dp"
                            android:text="Tutup Kamera"
                            android:textColor="@color/hadirku_text_muted"
                            android:textSize="11sp"
                            android:visibility="gone" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

            </LinearLayout>
        </LinearLayout>

        <!-- Final Selesai Absensi Button (Figma Solid Green Button) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnFinalSubmitAttendance"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="26dp"
            android:background="@drawable/bg_hadirku_primary_btn"
            android:enabled="false"
            android:text="Selesaikan Absensi"
            android:textAllCaps="false"
            android:textColor="@color/white"
            android:textSize="15sp"
            android:textStyle="bold"
            app:backgroundTint="@null"
            app:cornerRadius="14dp" />

        <TextView
            android:id="@+id/btnCancelVerification"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_horizontal"
            android:layout_marginTop="12dp"
            android:padding="8dp"
            android:text="Batal"
            android:textColor="@color/hadirku_text_muted"
            android:textSize="13sp" />

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
